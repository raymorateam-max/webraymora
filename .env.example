# WebRaymora — environment variables
# Copy to .env.local and fill in real values. All are content-slots.

# --- Site identity ---
NEXT_PUBLIC_SITE_NAME=Raymora
NEXT_PUBLIC_SITE_URL=https://webraymora.com
NEXT_PUBLIC_CONTACT_EMAIL=raymora.team@gmail.com
NEXT_PUBLIC_EXISTING_CLIENT_EMAIL=raymora.team@gmail.com

# --- Analytics (Plausible or Umami) ---
NEXT_PUBLIC_ANALYTICS_DOMAIN=webraymora.com
NEXT_PUBLIC_ANALYTICS_SCRIPT_URL=https://plausible.io/js/script.js

# --- Supabase (service-role key is SERVER-SIDE ONLY — never in client code) ---
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- n8n webhook → Google Sheets tracker ---
N8N_WEBHOOK_URL=https://your-n8n.example.com/webhook/agency-website-lead

# --- Lead notifications (Gmail SMTP via nodemailer — no third-party service) ---
# 1) Enable 2-Step Verification on the Gmail account.
# 2) Create an App Password: Google Account → Security → 2-Step Verification →
#    App passwords → generate for Mail. It's a 16-char code with spaces.
# 3) Paste it here (spaces are fine — nodemailer strips them). Server-side only.
GMAIL_USER=raymora.team@gmail.com
GMAIL_APP_PASSWORD=your-16-char-app-password
# Where every "Book a call" / contact submission notification is emailed.
# Defaults to GMAIL_USER when empty.
LEAD_NOTIFY_EMAIL=raymora.team@gmail.com

# --- Booking calendar (Cal.com) ---
NEXT_PUBLIC_CALCOM_URL=https://cal.com/your-username

# --- Live chat (Tawk.to) ---
NEXT_PUBLIC_TAWKTO_PROPERTY_ID=your-property-id
NEXT_PUBLIC_TAWKTO_WIDGET_ID=your-widget-id

# --- Quick-contact links ---
NEXT_PUBLIC_WHATSAPP_LINK=https://wa.me/0000000000
NEXT_PUBLIC_DISCORD_LINK=https://discord.gg/placeholder

# --- Meezan Bank deposit link (45% deposit / 55% on delivery) ---
# Optional. Empty = the deposit flow falls back to the WhatsApp button.
NEXT_PUBLIC_MEEZAN_DEPOSIT_LINK=
